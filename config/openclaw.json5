// Merge into ~/.openclaw/openclaw.json (or a profile's config).
// Kimi K3.1 Pro on Cerebras as the default model, per the hackathon's speed-patch example config,
// Keys come from the environment only.
{
  agents: {
    defaults: {
      model: { primary: "cerebras/moonshotai-kimi-k3.1-pro-trial" },
      thinkingDefault: "low",
    },
  },
  models: {
    mode: "merge",
    providers: {
      cerebras: {
        baseUrl: "https://api.cerebras.ai/v1",
        api: "openai-completions",
        apiKey: "${CEREBRAS_API_KEY}",
        models: [
          {
            id: "moonshotai-kimi-k3.1-pro-trial",
            name: "Kimi K3.1 Pro (Cerebras)",
            reasoning: true,
            input: ["text", "image"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            compat: {
              supportsTools: true,
              supportsStrictMode: false,
              supportsReasoningEffort: true,
              supportedReasoningEfforts: ["low", "high", "max"],
            },
          },
        ],
      },
    },
  },
  // Expose tools directly: fewer model round trips than the tool-search bridge.
  tools: { toolSearch: false },
}
